// Cloudflare Workers config cho FE (OpenNext adapter).
// Build local (miễn phí): `npm run cf:build` → deploy: `npm run cf:deploy`.
// Pilot chạy trên *.workers.dev — chưa gắn domain (đổi DNS khi nào chốt chuyển).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rexerai",
  // Token OAuth hiện tại thấy 2 account; thiếu dòng này thì mọi lệnh wrangler
  // non-interactive (deploy/secret trong script, CI) chết với "More than one
  // account available". Đây là account chứa Worker rexerai + zone rexerstudio.com.
  "account_id": "4317863407689551158dde2b1d21e398",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Domain thật (zone rexerstudio.com nằm cùng account Cloudflare):
  // - rexerstudio.com        → landing (middleware rewrite / → /rexer)
  // - portal.rexerstudio.com → app (middleware / → sign-in | role home)
  // - *.rexerstudio.com      → link check sau Deploy (spec §11.2), dạng
  //   {slug}.rexerstudio.com — middleware rewrite / → /p/{slug}. Wildcard
  //   PHẢI dùng "Route" (pattern có `*`), "Custom Domains" của Workers
  //   không nhận wildcard. Route này add trước khi middleware xử lý subdomain
  //   lên develop (2026-08-14) — cho tới lúc đó mọi {slug}.rexerstudio.com
  //   tạm fallback hiện landing, không lỗi.
  "routes": [
    { "pattern": "rexerstudio.com", "custom_domain": true },
    { "pattern": "portal.rexerstudio.com", "custom_domain": true },
    { "pattern": "*.rexerstudio.com/*", "zone_name": "rexerstudio.com" },
    // Custom domain của brand (Cloudflare for SaaS, 2026-09-04): traffic tới một
    // custom hostname đi qua fallback origin `fallback.rexerstudio.com`. CF KHÔNG
    // chạy Worker ở bước origin-pull đó — không có route phủ, request rơi vào
    // fallback như origin server thật, không ai trả lời → 522. Route `*/*` trên
    // zone (CF docs "Workers as your fallback origin") phủ cả custom hostname nên
    // Worker chặn trước, middleware resolve host → /p/{slug}.
    // PHẢI nằm trong file này: `wrangler deploy` ghi đè trigger list về đúng mảng
    // routes ở đây — thêm tay trên dashboard sẽ bị deploy sau xoá mất (đã dính
    // 2026-09-04). Route cụ thể hơn vẫn thắng nên subdomain/apex/portal không đổi.
    { "pattern": "*/*", "zone_name": "rexerstudio.com" },
  ],
  // Build-time public env được inline lúc `next build` (đọc .env/.env.production).
  // Runtime SECRETS (JWT_SECRET…) KHÔNG để đây — set bằng:
  //   npx wrangler secret put JWT_SECRET
  "vars": {
    "NEXT_PUBLIC_REXER_API": "https://rexerai.tekupsoftware.com",
  },
}

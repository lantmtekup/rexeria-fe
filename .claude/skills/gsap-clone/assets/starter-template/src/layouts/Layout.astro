---
import '@/styles/global.css';
interface Props { title?: string }
const { title = 'GSAP Clone' } = Astro.props;
---

<!doctype html>
<html lang="en" class="lenis">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:wght@400;500;600;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <script>
      import { initSmoothScroll } from '@/scripts/smooth-scroll';
      import { initAnimations } from '@/scripts/animations';

      // Wait for fonts so ScrollTrigger calculates correct positions
      document.fonts.ready.then(() => {
        initSmoothScroll();
        initAnimations();
      });
    </script>
  </body>
</html>

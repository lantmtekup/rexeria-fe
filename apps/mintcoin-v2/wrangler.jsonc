// CF Worker cho demo mintcoin-v2 (apps/mintcoin-v2). Build: npm run cf:build — Deploy: npm run cf:deploy
// Chạy trên *.workers.dev, chưa gắn domain.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rexerai-mintcoin-v2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [{ "pattern": "mintcoin-v2.rexerstudio.com", "custom_domain": true }]
}

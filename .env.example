# API
NEXT_PUBLIC_ASSETS_URL=
NEXT_PUBLIC_DOMAIN_IMAGE=

# Rexer Go BE — required. Next.js rewrites `/api/rexer/*` → `${…}/v1/*`.
# next.config.ts throws at boot if missing (no prod fallback, by design).
NEXT_PUBLIC_REXER_API=
# Rexer Go BE v2 deployment — optional, used by Portal V2 via `rxV2()`.
# Rewrites `/api/rexer-v2/*` → `${…}/v1/*`. basePath is still `/v1`: "v2"
# means a different host, not a different route prefix. When unset the
# rewrite is simply not registered and `rxV2()` throws only if called.
NEXT_PUBLIC_REXER_API_V2=

# SEO Configuration
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=

# Social Media Configuration
NEXT_PUBLIC_FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Google Configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (server-only, do not use NEXT_PUBLIC_)
MONGODB_URI=

# Contact form rate limiting
CONTACT_RATE_LIMIT=
CONTACT_RATE_WINDOW_MS=

# S3 upload (server-only) — align with backend `b` where applicable
STORAGE_SERVER=s3
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_REGION=
S3_BUCKET_NAME=
# Optional prefix inside the bucket (no leading/trailing slash)
S3_BUCKET_NAME_PATH=
# Optional; override public URL base for objects (HTTPS, no trailing slash). If set, used instead of virtual-hosted S3 URLs when NEXT_PUBLIC_DOMAIN_IMAGE is empty (server-only).
S3_PUBLIC_URL_BASE=
# Set false if the bucket uses "Bucket owner enforced" / ACLs disabled — use a bucket policy granting s3:GetObject for public reads instead of object ACLs.
S3_USE_ACL=
# Optional; pipe or comma list of extensions, e.g. jpg|jpeg|png|webp|pdf
UPLOAD_FILE_EXT=
# Optional; if set, POST /api/upload must send header x-upload-secret (Server Action gửi giúp)
UPLOAD_API_SECRET=

# Confirm trong app: copy từ upload/tmp → upload/image|file|… (giống `b`, không gọi Nest).
# Đặt true để chỉ giữ file ở tmp (debug).
UPLOAD_SKIP_CONFIRM=false

# Auth
JWT_SECRET=


# GA4 Measurement ID (G-XXXXXXX). Rỗng = tắt hẳn GA + consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Tracking key (server-only) — POST /api/forms đính vào header `X-ReXeR-Key`
# khi đẩy lead sang BE `/v1/forms/submit`.
#
# TUỲ CHỌN. Prod chạy với `app.allow_anonymous_ingest: true` ở BE, nên form vẫn
# gửi được khi để trống (BE chỉ nhận cho trang ĐÃ XUẤT BẢN). Đặt khoá vào đây
# là đường xác thực, tốt hơn — nhưng khoá gắn với MỘT brand nên chỉ dùng được
# cho triển khai một brand; đa brand thì để trống.
REXER_TRACKING_KEY=
